# Copia este archivo a .env SOLO para probar en tu computador. En Render estas variables se configuran en el panel.
DATABASE_URL=postgres://usuario:clave@host/basededatos?sslmode=require
SESSION_SECRET=cambia-esto-por-32-o-mas-caracteres-aleatorios
ADMIN_USER=ana
ADMIN_NAME=Ana Cortés
ADMIN_PASSWORD=UnaClaveLargaConLetrasY123
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Azure DevOps (opcional, solo lectura)
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_PROJECT=
AZURE_TEST_PROJECT=
AZURE_SYNC_MINUTES=30
# Tipos de work item que cuentan como bug (separados por coma). Por defecto: Bug
AZURE_BUG_TYPES=Bug
# Ambientes QA (opcional): Issues en Azure y correo
AZURE_DEVOPS_PAT_WRITE=
# Vacía = modo cola (apps_script_correo_cola.gs); con la URL /exec = modo directo (apps_script_correo.gs)
AMB_MAIL_URL=
AMB_MAIL_SECRET=
AMB_REMINDERS=on
AMB_REMINDER_MINUTES=10
